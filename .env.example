# ==============================================================================
# KONFIGURACJA ŚRODOWISKA DLA PAKIETU SKILLI: PRODUKCJA FILMÓW DOKUMENTALNYCH
# ==============================================================================
# Skopiuj ten plik jako '.env' i uzupełnij swoimi danymi przed uruchomieniem skilli:
# cp .env.example .env
#
# PAMIĘTAJ: Plik .env zawiera poufne dane i jest ignorowany w .gitignore.
# NIGDY nie commituj pliku .env do publicznego repozytorium!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE FLOW / VEO 2 / OMNI 1.1 CREDENTIALS
# ------------------------------------------------------------------------------
# Dane logowania do konta Google z dostępem do Google Flow (Labs VideoFX / Flow)
GOOGLE_FLOW_EMAIL="twoj_email_google@gmail.com"
GOOGLE_FLOW_PASSWORD="twoje_haslo_do_konta_google"

# Opcjonalnie: Port do podłączenia pod istniejącą sesję Chrome (CDP remote debugging)
# Uruchomienie Chrome z debugowaniem: chrome.exe --remote-debugging-port=9222
GOOGLE_CHROME_REMOTE_DEBUG_PORT="9222"

# ------------------------------------------------------------------------------
# 2. ELEVENLABS CREDENTIALS (SYNTEZA GŁOSU LEKTORA)
# ------------------------------------------------------------------------------
# Klucz API z portalu ElevenLabs (https://elevenlabs.io)
ELEVENLABS_API_KEY="sk_twoj_oficjalny_klucz_api_elevenlabs"

# Oficjalny, sprawdzony profil lektora dokumentalnego (Piotr - Neutral & Mature Bard)
ELEVENLABS_VOICE_ID="gFl0NeqphJUaoBLtWrqM"

# Model syntezy: zalecany 'eleven_v3' (wspiera naturalne tagi ekspresji emocjonalnej)
ELEVENLABS_MODEL_ID="eleven_v3"

# Domyślne parametry głosu dla modelu v3
ELEVENLABS_STABILITY="0.50"
ELEVENLABS_SIMILARITY_BOOST="0.80"

# ------------------------------------------------------------------------------
# 3. ŚCIEŻKI PRODUKCYJNE I ZASOBY (OPCJONALNE)
# ------------------------------------------------------------------------------
# Ścieżka do kotwicy wizerunkowej Świadka Dziejów (format 16:9)
DEFAULT_ANCHOR_IMAGE="./assets/anchors/swiadek_dziejow.jpg"

# Ścieżka do podkładu muzycznego z dynamicznym sidechain duckingiem
DEFAULT_MUSIC_FILE="./assets/music/soundtrack.mp3"

# Katalog na surowe klipy wideo z Flow (1280x720 24fps)
RAW_CLIPS_DIR="./raw_clips_16x9"

# Katalog wyjściowy dla zmontowanych wersji Master (Clean i Subtitled)
OUTPUT_DIR="./output_masters"
